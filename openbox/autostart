#!/usr/bin/env bash

# Project Helios Openbox startup

# Disable screen blanking, screen savers and display power management.
xset s off
xset s noblank
xset -dpms


# Start NetworkManager's tray process for maintenance access.
nm-applet &

# Run first-time application setup visibly before starting Helios.
if [ ! -f /var/lib/helios/first-boot-complete ]; then
    xterm         -fullscreen         -fa Monospace         -fs 18         -title "Project Helios First-Time Setup"         -e sudo /usr/local/bin/helios-first-boot-setup

    if [ ! -f /var/lib/helios/first-boot-complete ]; then
        xterm             -fullscreen             -fa Monospace             -fs 18             -title "Project Helios Setup Incomplete"             -e sh -c 'echo; echo "Project Helios setup did not complete."; echo; echo "Please check the internet connection and restart Helios."; echo; echo "Press Enter to close."; read answer'
        exit 1
    fi
fi

# Start Flex Launcher.
# If it crashes, restart it after a short delay.
while true; do
    /usr/local/bin/flex-launcher -d -c "$HOME/.config/flex-launcher/config.ini" >>"$HOME/flex-launcher.log" 2>&1
    EXIT_CODE=$?

    if [ "$EXIT_CODE" -eq 0 ]; then
        break
    fi

    echo "Flex Launcher exited unexpectedly with code $EXIT_CODE."
    echo "Restarting in 3 seconds..."
    sleep 3
done &
