#!/bin/bash
set -eux

cd /opt/helios

chmod +x scripts/*.sh
chmod +x install.sh || true

bash -x ./scripts/install-external.sh
bash -x ./scripts/configure-system.sh
bash -x ./scripts/install-flatpaks-system.sh
bash -x ./scripts/configure-boot.sh
bash -x ./scripts/configure-flex.sh
systemctl enable ssh.service
