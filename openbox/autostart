#!/usr/bin/env bash

# Project Helios Openbox startup

# Disable screen blanking, screen savers and display power management.
xset s off
xset s noblank
xset -dpms


# Start NetworkManager's tray process for maintenance access.
nm-applet &

# Complete first boot application setup before starting Helios.
if [ ! -f /var/lib/helios/first-boot-complete ]; then
    sudo systemctl start helios-first-boot-setup.service
fi

# Start Flex Launcher.
# If it crashes, restart it after a short delay.
while true; do
    /usr/local/bin/flex-launcher -d -c "$HOME/.config/flex-launcher/config.ini" >>"$HOME/flex-launcher.log" 2>&1
    EXIT_CODE=$?

    if [ "$EXIT_CODE" -eq 0 ]; then
        break
    fi

    echo "Flex Launcher exited unexpectedly with code $EXIT_CODE."
    echo "Restarting in 3 seconds..."
    sleep 3
done &
